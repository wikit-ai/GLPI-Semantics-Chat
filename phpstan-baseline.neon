parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$input of method CommonDBTM\:\:update\(\) expects array\<string, mixed\>, array\<mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: front/config.form.php

		-
			message: '#^Parameter \#2 \$url of static method Html\:\:header\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: front/config.form.php

		-
			message: '#^Parameter \#3 \$input of method CommonDBTM\:\:check\(\) expects array\<string, mixed\>\|null, array\<mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: front/config.form.php

		-
			message: '#^Cannot access offset ''field'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: hook.php

		-
			message: '#^Cannot access offset ''id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: hook.php

		-
			message: '#^Parameter \#1 \$profileId of static method GlpiPlugin\\Wikitsemanticschat\\Profile\:\:createFirstAccess\(\) expects int, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: hook.php

		-
			message: '#^Cannot access offset ''id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: setup.php

		-
			message: '#^Cannot access offset ''wikitsemanticschat'' on mixed\.$#'
