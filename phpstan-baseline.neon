			count: 3
			path: src/Config.php

		-
			message: '#^Binary operation "\." between mixed and ''px'' results in an error\.$#'
			identifier: binaryOp.invalid
			count: 2
			path: src/Config.php

		-
			message: '#^Method GlpiPlugin\\Wikitsemanticschat\\Config\:\:defineTabs\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Config.php

		-
			message: '#^Method GlpiPlugin\\Wikitsemanticschat\\Config\:\:defineTabs\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Config.php

		-
			message: '#^Method GlpiPlugin\\Wikitsemanticschat\\Config\:\:getJsConfig\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Config.php

		-
			message: '#^Method GlpiPlugin\\Wikitsemanticschat\\Config\:\:showForm\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Config.php

		-
			message: '#^Parameter \#2 \$options of method CommonDBTM\:\:initForm\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/Config.php

		-
			message: '#^Cannot access offset ''field'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 4
			path: src/Profile.php

		-
			message: '#^Cannot access offset ''id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Profile.php

		-
			message: '#^Cannot access offset ''name'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Profile.php

		-
			message: '#^Cannot access offset ''rights'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
