{
    "name": "wikit/glpi-semantics-chat",
    "description": "GLPI plugin to inject Semantics Chat AI assistant widget",
    "type": "glpi-plugin",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Wikit SAS",
            "email": "dev@wikit.ai",
            "homepage": "https://www.wikit.ai"
        }
    ],
    "homepage": "https://github.com/wikit-ai/GLPI-Semantics-Chat",
    "support": {
        "issues": "https://github.com/wikit-ai/GLPI-Semantics-Chat/issues",
        "source": "https://github.com/wikit-ai/GLPI-Semantics-Chat"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "glpi-project/tools": "^0.8"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Wikitsemanticschat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Wikitsemanticschat\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "glpi-project/tools": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "autoloader-suffix": "PluginWikitsemanticschat",
        "platform": {
            "php": "8.3.99"
        }
    }
}
